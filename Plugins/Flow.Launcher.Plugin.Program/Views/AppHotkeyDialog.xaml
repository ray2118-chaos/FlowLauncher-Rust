<Window
    x:Class="Flow.Launcher.Plugin.Program.Views.AppHotkeyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="Record Hotkey"
    Width="520"
    Background="{DynamicResource PopuBGColor}"
    Foreground="{DynamicResource PopupTextColor}"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewKeyUp="Window_PreviewKeyUp"
    Focusable="True"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="KeyPillBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="{DynamicResource Color02B}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color04B}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="KeyPillText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource PopupTextColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar header with Close button -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <Button
                DockPanel.Dock="Right"
                Click="BtnCancel_OnClick"
                Style="{StaticResource TitleBarCloseButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <Path
                    Width="40"
                    Height="24"
                    Data="M 15,8 25,16 M 15,16 25,8"
                    Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1" />
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image
                    x:Name="imgAppIcon"
                    Width="28"
                    Height="28"
                    Margin="0,0,12,0"
                    RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="txtAppName"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Application Name"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource PopupTextColor}" />
                    <TextBlock
                        FontSize="11"
                        Opacity="0.65"
                        Text="Assign Global Application Hotkey"
                        Foreground="{DynamicResource PopupTextColor}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Separator Grid.Row="1" Margin="0,14,0,16" Style="{StaticResource SettingPanelSeparatorStyle}" />

        <!-- Key recording display box -->
        <Border
            Grid.Row="2"
            CornerRadius="10"
            Background="{DynamicResource Color01B}"
            BorderBrush="{DynamicResource Color03B}"
            BorderThickness="1.5"
            Padding="18,22"
            MinHeight="96">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <WrapPanel x:Name="pillsContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Key pills dynamically inserted or placeholder -->
                    <TextBlock
                        x:Name="txtPlaceholder"
                        FontSize="13"
                        FontStyle="Italic"
                        Opacity="0.6"
                        Text="Press your shortcut combination (e.g. Win + B, Alt + Space, Ctrl + Shift + C)..."
                        Foreground="{DynamicResource PopupTextColor}" />
                </WrapPanel>
                <TextBlock
                    x:Name="txtStatusMessage"
                    Margin="0,10,0,0"
                    FontSize="11"
                    HorizontalAlignment="Center"
                    Text=""
                    Foreground="#FF5555"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Repeated Key Presets & Instructions -->
        <StackPanel Grid.Row="3" Margin="0,12,0,18" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="Repeated Keys: " FontSize="11.5" Opacity="0.75" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource PopupTextColor}" />
                <Button Content="Double Ctrl" Click="BtnPresetDouble_OnClick" Tag="Ctrl + Ctrl" Margin="2,0" Padding="8,3" FontSize="11" Style="{StaticResource DefaultButtonStyle}" Cursor="Hand" />
                <Button Content="Double Alt" Click="BtnPresetDouble_OnClick" Tag="Alt + Alt" Margin="2,0" Padding="8,3" FontSize="11" Style="{StaticResource DefaultButtonStyle}" Cursor="Hand" />
                <Button Content="Double Shift" Click="BtnPresetDouble_OnClick" Tag="Shift + Shift" Margin="2,0" Padding="8,3" FontSize="11" Style="{StaticResource DefaultButtonStyle}" Cursor="Hand" />
                <Button Content="Double Win" Click="BtnPresetDouble_OnClick" Tag="Win + Win" Margin="2,0" Padding="8,3" FontSize="11" Style="{StaticResource DefaultButtonStyle}" Cursor="Hand" />
            </StackPanel>
            <TextBlock
                FontSize="11"
                Opacity="0.65"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                Text="Press a shortcut combination (e.g. Win + B) or double-tap a key (e.g. tap Ctrl twice). Press Esc to cancel."
                Foreground="{DynamicResource PopupTextColor}" />
        </StackPanel>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button
                DockPanel.Dock="Left"
                x:Name="btnClear"
                Click="BtnClear_OnClick"
                Padding="16,6"
                Content="Clear Hotkey"
                Style="{StaticResource DefaultButtonStyle}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button
                    x:Name="btnCancel"
                    Click="BtnCancel_OnClick"
                    Margin="0,0,10,0"
                    Padding="18,6"
                    Content="Cancel"
                    Style="{StaticResource DefaultButtonStyle}" />
                <Button
                    x:Name="btnSave"
                    Click="BtnSave_OnClick"
                    IsEnabled="False"
                    Padding="22,6"
                    Content="Save"
                    FontWeight="SemiBold"
                    Style="{StaticResource DefaultButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
