<Window
    x:Class="Flow.Launcher.Plugin.Program.Views.AppAliasDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Set Alias"
    Width="460"
    Background="{DynamicResource PopuBGColor}"
    Foreground="{DynamicResource PopupTextColor}"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    Loaded="Window_Loaded"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar header with Close button -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <Button
                DockPanel.Dock="Right"
                Click="BtnCancel_OnClick"
                Style="{StaticResource TitleBarCloseButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <Path
                    Width="40"
                    Height="24"
                    Data="M 15,8 25,16 M 15,16 25,8"
                    Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1" />
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image
                    x:Name="imgAppIcon"
                    Width="28"
                    Height="28"
                    Margin="0,0,12,0"
                    RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="txtAppName"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Application Name"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource PopupTextColor}" />
                    <TextBlock
                        FontSize="11"
                        Opacity="0.65"
                        Text="Assign Search Alias"
                        Foreground="{DynamicResource PopupTextColor}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Separator Grid.Row="1" Margin="0,14,0,16" Style="{StaticResource SettingPanelSeparatorStyle}" />

        <!-- Input Section -->
        <StackPanel Grid.Row="2">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="12"
                Text="Custom Alias / Keyword:"
                Foreground="{DynamicResource PopupTextColor}" />
            <TextBox
                x:Name="tbAlias"
                Height="36"
                FontSize="14"
                Padding="8,6"
                KeyDown="TbAlias_OnKeyDown"
                Style="{StaticResource DefaultTextBoxStyle}" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="11"
                Opacity="0.7"
                TextWrapping="Wrap"
                Text="Typing this alias into Flow Launcher will immediately place this application at the very top of search results."
                Foreground="{DynamicResource PopupTextColor}" />
        </StackPanel>

        <Separator Grid.Row="3" Margin="0,16,0,16" Style="{StaticResource SettingPanelSeparatorStyle}" />

        <!-- Action Buttons -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button
                DockPanel.Dock="Left"
                x:Name="btnRemove"
                Click="BtnRemove_OnClick"
                Padding="16,6"
                Content="Remove Alias"
                Style="{StaticResource DefaultButtonStyle}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button
                    x:Name="btnCancel"
                    Click="BtnCancel_OnClick"
                    Margin="0,0,10,0"
                    Padding="18,6"
                    Content="Cancel"
                    Style="{StaticResource DefaultButtonStyle}" />
                <Button
                    x:Name="btnSave"
                    Click="BtnSave_OnClick"
                    Padding="22,6"
                    Content="Save"
                    FontWeight="SemiBold"
                    Style="{StaticResource DefaultButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
