<!--
    Name: Liquid Glass 2.0
    IsDark: True
    HasBlur: True
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Theme & Icon Pack Settings -->
    <system:Boolean x:Key="ThemeBlurEnabled">True</system:Boolean>
    <system:String x:Key="ThemeIconPack">Windows11</system:String>
    <system:String x:Key="SystemBG">Dark</system:String>
    <Color x:Key="LightBG">#C5061020</Color>
    <Color x:Key="DarkBG">#AA030814</Color>

    <!-- Layout Metrics -->
    <Thickness x:Key="ResultMargin">0 6 0 8</Thickness>
    <Thickness x:Key="ItemMargin">8 3 8 3</Thickness>
    <CornerRadius x:Key="ItemRadius">14</CornerRadius>
    <system:Double x:Key="ResultItemHeight">56</system:Double>

    <!-- Fluid Refractive Caustic Gradients (Electric Aqua -> Deep Ocean Blue -> Royal Indigo) -->
    <LinearGradientBrush x:Key="LiquidGlass2BorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#00E5FF" />
        <GradientStop Offset="0.32" Color="#0072FF" />
        <GradientStop Offset="0.68" Color="#6B11FF" />
        <GradientStop Offset="1.0" Color="#00E5FF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidGlass2CapsuleBorderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#9000E5FF" />
        <GradientStop Offset="0.5" Color="#600072FF" />
        <GradientStop Offset="1.0" Color="#806B11FF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidGlass2QueryBoxBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#3500E5FF" />
        <GradientStop Offset="0.35" Color="#18030918" />
        <GradientStop Offset="1.0" Color="#28051228" />
    </LinearGradientBrush>



    <!-- Result Item Interactive Colors (Deep Translucent Caustic Fill & Specular Shimmer) -->
    <LinearGradientBrush x:Key="ItemSelectedBorderColor" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#9900E5FF" />
        <GradientStop Offset="0.5" Color="#700072FF" />
        <GradientStop Offset="1.0" Color="#856B11FF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ItemSelectedBackgroundColor" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#3C00E5FF" />
        <GradientStop Offset="0.45" Color="#260060FF" />
        <GradientStop Offset="1.0" Color="#346B11FF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ItemHoverBackgroundColor">#1A00E5FF</SolidColorBrush>
    <SolidColorBrush x:Key="ItemHoverBorderColor">#3800E5FF</SolidColorBrush>

    <!-- Window Styles -->
    <Style x:Key="WindowRadius" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <Style
        x:Key="WindowBorderStyle"
        BasedOn="{StaticResource BaseWindowBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{StaticResource LiquidGlass2BorderBrush}" />
        <Setter Property="Background" Value="#A5030814" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style
        x:Key="WindowStyle"
        BasedOn="{StaticResource BaseWindowStyle}"
        TargetType="{x:Type Window}" />

    <!-- Query Box Styles (Floating Liquid Capsule) -->
    <Style
        x:Key="QueryBoxBgStyle"
        BasedOn="{StaticResource BaseQueryBoxBgStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="10 8 10 4" />
        <Setter Property="Background" Value="{StaticResource LiquidGlass2QueryBoxBgBrush}" />
        <Setter Property="BorderThickness" Value="1.3" />
        <Setter Property="BorderBrush" Value="{StaticResource LiquidGlass2CapsuleBorderBrush}" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style
        x:Key="QueryBoxStyle"
        BasedOn="{StaticResource BaseQueryBoxStyle}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="0 0 52 0" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="CaretBrush" Value="#00E5FF" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style
        x:Key="QuerySuggestionBoxStyle"
        BasedOn="{StaticResource BaseQuerySuggestionBoxStyle}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="0 0 52 0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="#6000E5FF" />
    </Style>

    <!-- Separators & Pending Line -->
    <Style
        x:Key="SeparatorStyle"
        BasedOn="{StaticResource BaseSeparatorStyle}"
        TargetType="{x:Type Rectangle}">
        <Setter Property="Fill">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#0000E5FF" />
                    <GradientStop Offset="0.25" Color="#5000E5FF" />
                    <GradientStop Offset="0.5" Color="#800072FF" />
                    <GradientStop Offset="0.75" Color="#506B11FF" />
                    <GradientStop Offset="1.0" Color="#006B11FF" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Height" Value="1.2" />
        <Setter Property="Margin" Value="12 4 12 6" />
    </Style>

    <Style
        x:Key="PendingLineStyle"
        BasedOn="{StaticResource BasePendingLineStyle}"
        TargetType="{x:Type Line}">
        <Setter Property="Stroke">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#00E5FF" />
                    <GradientStop Offset="0.5" Color="#0072FF" />
                    <GradientStop Offset="1.0" Color="#6B11FF" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Result Item Typography -->
    <Style
        x:Key="ItemTitleStyle"
        BasedOn="{StaticResource BaseItemTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F2F8FF" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="ItemSubTitleStyle"
        BasedOn="{StaticResource BaseItemSubTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#82A6C8" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
        x:Key="ItemTitleSelectedStyle"
        BasedOn="{StaticResource BaseItemTitleSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style
        x:Key="ItemSubTitleSelectedStyle"
        BasedOn="{StaticResource BaseItemSubTitleSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#A5F0FF" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="HighlightStyle">
        <Setter Property="Inline.FontWeight" Value="ExtraBold" />
        <Setter Property="Inline.Foreground" Value="#00E5FF" />
    </Style>

    <!-- Selection Capsule Indicator -->
    <Style
        x:Key="BulletStyle"
        BasedOn="{StaticResource BaseBulletStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style
        x:Key="ItemBulletSelectedStyle"
        BasedOn="{StaticResource BaseBulletStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="3.5" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="4 0 0 0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#00E5FF" />
                    <GradientStop Offset="1.0" Color="#0072FF" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hotkey Badges -->
    <Style
        x:Key="ItemHotkeyStyle"
        BasedOn="{StaticResource BaseItemHotkeyStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#78B0D8" />
    </Style>

    <Style
        x:Key="ItemHotkeySelectedStyle"
        BasedOn="{StaticResource BaseItemHotkeySelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style
        x:Key="ItemHotkeyBGStyle"
        BasedOn="{StaticResource BaseItemHotkeyBGStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="6 0 10 0" />
        <Setter Property="Padding" Value="7 3 7 3" />
        <Setter Property="Background" Value="#1500E5FF" />
        <Setter Property="BorderBrush" Value="#3000E5FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style
        x:Key="ItemHotkeyBGSelectedStyle"
        BasedOn="{StaticResource BaseItemHotkeyBGSelectedStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="6 0 10 0" />
        <Setter Property="Padding" Value="7 3 7 3" />
        <Setter Property="Background" Value="#3500E5FF" />
        <Setter Property="BorderBrush" Value="#7000E5FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>



    <!-- Clock Styles -->
    <Style
        x:Key="ClockPanel"
        BasedOn="{StaticResource BaseClockPanel}"
        TargetType="{x:Type StackPanel}">
        <Setter Property="Margin" Value="0 0 72 0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="ClockBox"
        BasedOn="{StaticResource BaseClockBox}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E0F8FF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="DateBox"
        BasedOn="{StaticResource BaseDateBox}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#78B0D8" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <!-- Glyph Styling -->
    <Style
        x:Key="ItemGlyph"
        BasedOn="{StaticResource BaseGlyphStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#00E5FF" />
    </Style>

    <!-- ScrollBar Styles -->
    <Style
        x:Key="ThumbStyle"
        BasedOn="{StaticResource BaseThumbStyle}"
        TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        Background="#5000E5FF"
                        BorderBrush="Transparent"
                        CornerRadius="2"
                        DockPanel.Dock="Right" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ScrollBarStyle"
        BasedOn="{StaticResource BaseScrollBarStyle}"
        TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="4" />
    </Style>

</ResourceDictionary>
