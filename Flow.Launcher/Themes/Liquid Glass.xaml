<!--
    Name: Liquid Glass
    IsDark: True
    HasBlur: True
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Theme & Icon Pack Settings -->
    <system:Boolean x:Key="ThemeBlurEnabled">True</system:Boolean>
    <system:String x:Key="ThemeIconPack">Windows11</system:String>
    <system:String x:Key="SystemBG">Dark</system:String>
    <Color x:Key="LightBG">#B80C1B2E</Color>
    <Color x:Key="DarkBG">#A5050C18</Color>

    <!-- Layout Metrics -->
    <Thickness x:Key="ResultMargin">0 6 0 8</Thickness>
    <Thickness x:Key="ItemMargin">8 3 8 3</Thickness>
    <CornerRadius x:Key="ItemRadius">12</CornerRadius>
    <system:Double x:Key="ResultItemHeight">56</system:Double>

    <!-- Fluid Refractive Caustic Gradients -->
    <LinearGradientBrush x:Key="LiquidGlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#00F2FE" />
        <GradientStop Offset="0.3" Color="#4FACFE" />
        <GradientStop Offset="0.65" Color="#0072FF" />
        <GradientStop Offset="0.85" Color="#7F00FF" />
        <GradientStop Offset="1.0" Color="#00F2FE" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidCapsuleBorderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#8000F2FE" />
        <GradientStop Offset="0.5" Color="#500072FF" />
        <GradientStop Offset="1.0" Color="#807F00FF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidQueryBoxBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#3000E5FF" />
        <GradientStop Offset="0.4" Color="#18040C1A" />
        <GradientStop Offset="1.0" Color="#25061426" />
    </LinearGradientBrush>

    <!-- Result Item Interactive Colors (Liquid Shimmer & Deep Translucent Caustic Fill) -->
    <LinearGradientBrush x:Key="ItemSelectedBorderColor" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#9000F2FE" />
        <GradientStop Offset="0.5" Color="#600072FF" />
        <GradientStop Offset="1.0" Color="#807F00FF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ItemSelectedBackgroundColor" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#3800F2FE" />
        <GradientStop Offset="0.45" Color="#240066FF" />
        <GradientStop Offset="1.0" Color="#327F00FF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ItemHoverBackgroundColor">#1800F2FE</SolidColorBrush>
    <SolidColorBrush x:Key="ItemHoverBorderColor">#3500F2FE</SolidColorBrush>

    <!-- Window Styles -->
    <Style x:Key="WindowRadius" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <Style
        x:Key="WindowBorderStyle"
        BasedOn="{StaticResource BaseWindowBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{StaticResource LiquidGlassBorderBrush}" />
        <Setter Property="Background" Value="#A0050C18" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style
        x:Key="WindowStyle"
        BasedOn="{StaticResource BaseWindowStyle}"
        TargetType="{x:Type Window}" />

    <!-- Query Box Styles (Floating Liquid Capsule with Specular Caustic Accent) -->
    <Style
        x:Key="QueryBoxBgStyle"
        BasedOn="{StaticResource BaseQueryBoxBgStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="10 8 10 4" />
        <Setter Property="Background" Value="{StaticResource LiquidQueryBoxBgBrush}" />
        <Setter Property="BorderThickness" Value="1.3" />
        <Setter Property="BorderBrush" Value="{StaticResource LiquidCapsuleBorderBrush}" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style
        x:Key="QueryBoxStyle"
        BasedOn="{StaticResource BaseQueryBoxStyle}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="0 0 52 0" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="CaretBrush" Value="#00F2FE" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style
        x:Key="QuerySuggestionBoxStyle"
        BasedOn="{StaticResource BaseQuerySuggestionBoxStyle}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="0 0 52 0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="#50A0D0" />
    </Style>

    <!-- Separators & Pending Line (Glowing Liquid Seam) -->
    <Style
        x:Key="SeparatorStyle"
        BasedOn="{StaticResource BaseSeparatorStyle}"
        TargetType="{x:Type Rectangle}">
        <Setter Property="Fill">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#0000F2FE" />
                    <GradientStop Offset="0.25" Color="#4000F2FE" />
                    <GradientStop Offset="0.5" Color="#700072FF" />
                    <GradientStop Offset="0.75" Color="#407F00FF" />
                    <GradientStop Offset="1.0" Color="#007F00FF" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Height" Value="1.2" />
        <Setter Property="Margin" Value="12 4 12 6" />
    </Style>

    <Style
        x:Key="PendingLineStyle"
        BasedOn="{StaticResource BasePendingLineStyle}"
        TargetType="{x:Type Line}">
        <Setter Property="Stroke">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#00F2FE" />
                    <GradientStop Offset="0.5" Color="#0072FF" />
                    <GradientStop Offset="1.0" Color="#7F00FF" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Result Item Typography (Crisp Luminous Contrast) -->
    <Style
        x:Key="ItemTitleStyle"
        BasedOn="{StaticResource BaseItemTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F0F6FC" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="ItemSubTitleStyle"
        BasedOn="{StaticResource BaseItemSubTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#80A4C4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
        x:Key="ItemTitleSelectedStyle"
        BasedOn="{StaticResource BaseItemTitleSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style
        x:Key="ItemSubTitleSelectedStyle"
        BasedOn="{StaticResource BaseItemSubTitleSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#90E0EF" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="HighlightStyle">
        <Setter Property="Inline.FontWeight" Value="ExtraBold" />
        <Setter Property="Inline.Foreground" Value="#00F2FE" />
    </Style>

    <!-- Selection Capsule Indicator (Glowing Cyan Fluid Notch) -->
    <Style
        x:Key="BulletStyle"
        BasedOn="{StaticResource BaseBulletStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style
        x:Key="ItemBulletSelectedStyle"
        BasedOn="{StaticResource BaseBulletStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="3.5" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="4 0 0 0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#00F2FE" />
                    <GradientStop Offset="1.0" Color="#0072FF" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hotkey Badges (Liquid Glass Capsules: [Alt 1]) -->
    <Style
        x:Key="ItemHotkeyStyle"
        BasedOn="{StaticResource BaseItemHotkeyStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#70A8D0" />
    </Style>

    <Style
        x:Key="ItemHotkeySelectedStyle"
        BasedOn="{StaticResource BaseItemHotkeySelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style
        x:Key="ItemHotkeyBGStyle"
        BasedOn="{StaticResource BaseItemHotkeyBGStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="6 0 10 0" />
        <Setter Property="Padding" Value="7 3 7 3" />
        <Setter Property="Background" Value="#1200F2FE" />
        <Setter Property="BorderBrush" Value="#2500F2FE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style
        x:Key="ItemHotkeyBGSelectedStyle"
        BasedOn="{StaticResource BaseItemHotkeyBGSelectedStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="6 0 10 0" />
        <Setter Property="Padding" Value="7 3 7 3" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderBrush" Value="#6000F2FE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#300072FF" />
    </Style>

    <!-- Glyphs & Icons -->
    <Style
        x:Key="ItemGlyph"
        BasedOn="{StaticResource BaseGlyphStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#90B8D8" />
    </Style>

    <Style
        x:Key="ItemGlyphSelectedStyle"
        BasedOn="{StaticResource BaseGlyphSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#00F2FE" />
    </Style>

    <!-- Preview Area Styles -->
    <Style
        x:Key="PreviewBorderStyle"
        BasedOn="{StaticResource BasePreviewBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="#3000F2FE" />
    </Style>

    <Style
        x:Key="PreviewItemTitleStyle"
        BasedOn="{StaticResource BasePreviewItemTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style
        x:Key="PreviewItemSubTitleStyle"
        BasedOn="{StaticResource BasePreviewItemSubTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#90B8D8" />
    </Style>

    <!-- ScrollBar Styles -->
    <Style
        x:Key="ThumbStyle"
        BasedOn="{StaticResource BaseThumbStyle}"
        TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        Background="#3500F2FE"
                        BorderBrush="Transparent"
                        CornerRadius="3"
                        DockPanel.Dock="Right" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ScrollBarStyle"
        BasedOn="{StaticResource BaseScrollBarStyle}"
        TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="5" />
    </Style>

</ResourceDictionary>
