<!--
    Name: Synthwave 84
    IsDark: True
    HasBlur: True
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Theme & Icon Pack Settings -->
    <system:Boolean x:Key="ThemeBlurEnabled">True</system:Boolean>
    <system:String x:Key="ThemeIconPack">Default</system:String>
    <system:String x:Key="SystemBG">Dark</system:String>
    <Color x:Key="LightBG">#D81E0F38</Color>
    <Color x:Key="DarkBG">#E617072B</Color>

    <!-- Layout Metrics -->
    <Thickness x:Key="ResultMargin">0 6 0 8</Thickness>
    <Thickness x:Key="ItemMargin">8 3 8 3</Thickness>
    <CornerRadius x:Key="ItemRadius">12</CornerRadius>
    <system:Double x:Key="ResultItemHeight">54</system:Double>

    <!-- Gradients & Accents -->
    <LinearGradientBrush x:Key="ItemSelectedBorderColor" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#FF7EDB" />
        <GradientStop Offset="0.6" Color="#B239FF" />
        <GradientStop Offset="1.0" Color="#36F9F6" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ItemSelectedBackgroundColor">#2C124D</SolidColorBrush>
    <SolidColorBrush x:Key="ItemHoverBackgroundColor">#200B3B</SolidColorBrush>
    <SolidColorBrush x:Key="ItemHoverBorderColor">#722485</SolidColorBrush>

    <!-- Window Styles -->
    <Style x:Key="WindowRadius" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style
        x:Key="WindowBorderStyle"
        BasedOn="{StaticResource BaseWindowBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#E617072B" />
        <Setter Property="BorderBrush" Value="#FF7EDB" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style
        x:Key="WindowStyle"
        BasedOn="{StaticResource BaseWindowStyle}"
        TargetType="{x:Type Window}">
        <Setter Property="Width" Value="640" />
    </Style>

    <!-- Search Box Capsule -->
    <Style
        x:Key="QueryBoxStyle"
        BasedOn="{StaticResource BaseQueryBoxStyle}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="#FDF6FF" />
        <Setter Property="CaretBrush" Value="#FF7EDB" />
        <Setter Property="SelectionBrush" Value="#722485" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="48 10 50 10" />
    </Style>

    <Style
        x:Key="QuerySuggestionBoxStyle"
        BasedOn="{StaticResource BaseQuerySuggestionBoxStyle}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="#725B8C" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="48 10 50 10" />
    </Style>

    <Style
        x:Key="SearchIconStyle"
        BasedOn="{StaticResource BaseSearchIconStyle}"
        TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="#36F9F6" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Opacity" Value="0.95" />
    </Style>

    <Style
        x:Key="SeparatorStyle"
        BasedOn="{StaticResource BaseSeparatorStyle}"
        TargetType="{x:Type Rectangle}">
        <Setter Property="Fill" Value="#36175E" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12 4 12 4" />
    </Style>

    <!-- Item Typography -->
    <Style
        x:Key="ItemTitleStyle"
        BasedOn="{StaticResource BaseItemTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FDF6FF" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style
        x:Key="ItemSubTitleStyle"
        BasedOn="{StaticResource BaseItemSubTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#9F83C2" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
        x:Key="ItemTitleSelectedStyle"
        BasedOn="{StaticResource BaseItemTitleSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FF7EDB" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="ItemSubTitleSelectedStyle"
        BasedOn="{StaticResource BaseItemSubTitleSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F3B3FF" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="HighlightStyle">
        <Setter Property="Inline.Foreground" Value="#FFE600" />
        <Setter Property="Inline.FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="ItemHotkeyStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#725B8C" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
        x:Key="ItemHotkeySelectedStyle"
        BasedOn="{StaticResource BaseItemHotkeySelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#36F9F6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="ThumbStyle"
        BasedOn="{StaticResource BaseThumbStyle}"
        TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        Background="#FF7EDB"
                        CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
