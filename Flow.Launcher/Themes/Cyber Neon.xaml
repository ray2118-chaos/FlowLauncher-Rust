<!--
    Name: Cyber Neon
    IsDark: True
    HasBlur: True
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Theme & Icon Pack Settings -->
    <system:Boolean x:Key="ThemeBlurEnabled">True</system:Boolean>
    <system:String x:Key="ThemeIconPack">Windows11</system:String>
    <system:String x:Key="SystemBG">Dark</system:String>
    <Color x:Key="LightBG">#D00D0F18</Color>
    <Color x:Key="DarkBG">#B807080E</Color>

    <!-- Layout Metrics -->
    <Thickness x:Key="ResultMargin">0 6 0 8</Thickness>
    <Thickness x:Key="ItemMargin">8 3 8 3</Thickness>
    <CornerRadius x:Key="ItemRadius">12</CornerRadius>
    <system:Double x:Key="ResultItemHeight">56</system:Double>

    <!-- Laser Cyber Gradients (Electric Cyan -> Royal Purple -> Hot Magenta) -->
    <LinearGradientBrush x:Key="CyberNeonBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#00F2FE" />
        <GradientStop Offset="0.35" Color="#7928CA" />
        <GradientStop Offset="0.7" Color="#FF007F" />
        <GradientStop Offset="1.0" Color="#00F2FE" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyberCapsuleBorderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#8000F2FE" />
        <GradientStop Offset="0.5" Color="#607928CA" />
        <GradientStop Offset="1.0" Color="#80FF007F" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyberQueryBoxBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#2800F2FE" />
        <GradientStop Offset="0.4" Color="#18070812" />
        <GradientStop Offset="1.0" Color="#220D0F1C" />
    </LinearGradientBrush>



    <!-- Result Item Interactive Colors (Holographic Cyan-to-Magenta Wash) -->
    <LinearGradientBrush x:Key="ItemSelectedBorderColor" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#9900F2FE" />
        <GradientStop Offset="0.6" Color="#807928CA" />
        <GradientStop Offset="1.0" Color="#90FF007F" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ItemSelectedBackgroundColor" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#3800F2FE" />
        <GradientStop Offset="0.5" Color="#247928CA" />
        <GradientStop Offset="1.0" Color="#32FF007F" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ItemHoverBackgroundColor">#1800F2FE</SolidColorBrush>
    <SolidColorBrush x:Key="ItemHoverBorderColor">#3500F2FE</SolidColorBrush>

    <!-- Window Styles -->
    <Style x:Key="WindowRadius" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <Style
        x:Key="WindowBorderStyle"
        BasedOn="{StaticResource BaseWindowBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{StaticResource CyberNeonBorderBrush}" />
        <Setter Property="Background" Value="#B007080E" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style
        x:Key="WindowStyle"
        BasedOn="{StaticResource BaseWindowStyle}"
        TargetType="{x:Type Window}" />

    <!-- Query Box Styles (Obsidian Well with Dual Laser Glow) -->
    <Style
        x:Key="QueryBoxBgStyle"
        BasedOn="{StaticResource BaseQueryBoxBgStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="10 8 10 4" />
        <Setter Property="Background" Value="{StaticResource CyberQueryBoxBgBrush}" />
        <Setter Property="BorderThickness" Value="1.3" />
        <Setter Property="BorderBrush" Value="{StaticResource CyberCapsuleBorderBrush}" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style
        x:Key="QueryBoxStyle"
        BasedOn="{StaticResource BaseQueryBoxStyle}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="0 0 52 0" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="CaretBrush" Value="#FF007F" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style
        x:Key="QuerySuggestionBoxStyle"
        BasedOn="{StaticResource BaseQuerySuggestionBoxStyle}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="0 0 52 0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="#6000F2FE" />
    </Style>

    <!-- Separators & Pending Line (Laser Gradient Seam) -->
    <Style
        x:Key="SeparatorStyle"
        BasedOn="{StaticResource BaseSeparatorStyle}"
        TargetType="{x:Type Rectangle}">
        <Setter Property="Fill">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#0000F2FE" />
                    <GradientStop Offset="0.25" Color="#5000F2FE" />
                    <GradientStop Offset="0.5" Color="#807928CA" />
                    <GradientStop Offset="0.75" Color="#50FF007F" />
                    <GradientStop Offset="1.0" Color="#00FF007F" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Height" Value="1.2" />
        <Setter Property="Margin" Value="12 4 12 6" />
    </Style>

    <Style
        x:Key="PendingLineStyle"
        BasedOn="{StaticResource BasePendingLineStyle}"
        TargetType="{x:Type Line}">
        <Setter Property="Stroke">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#00F2FE" />
                    <GradientStop Offset="0.5" Color="#7928CA" />
                    <GradientStop Offset="1.0" Color="#FF007F" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Result Item Typography -->
    <Style
        x:Key="ItemTitleStyle"
        BasedOn="{StaticResource BaseItemTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="ItemSubTitleStyle"
        BasedOn="{StaticResource BaseItemSubTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#90A0B8" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
        x:Key="ItemTitleSelectedStyle"
        BasedOn="{StaticResource BaseItemTitleSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style
        x:Key="ItemSubTitleSelectedStyle"
        BasedOn="{StaticResource BaseItemSubTitleSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#A0F0FF" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="HighlightStyle">
        <Setter Property="Inline.FontWeight" Value="ExtraBold" />
        <Setter Property="Inline.Foreground" Value="#00F2FE" />
    </Style>

    <!-- Selection Capsule Indicator -->
    <Style
        x:Key="BulletStyle"
        BasedOn="{StaticResource BaseBulletStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style
        x:Key="ItemBulletSelectedStyle"
        BasedOn="{StaticResource BaseBulletStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="3.5" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="4 0 0 0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#00F2FE" />
                    <GradientStop Offset="1.0" Color="#FF007F" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hotkey Badges -->
    <Style
        x:Key="ItemHotkeyStyle"
        BasedOn="{StaticResource BaseItemHotkeyStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#80B0D8" />
    </Style>

    <Style
        x:Key="ItemHotkeySelectedStyle"
        BasedOn="{StaticResource BaseItemHotkeySelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style
        x:Key="ItemHotkeyBGStyle"
        BasedOn="{StaticResource BaseItemHotkeyBGStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="6 0 10 0" />
        <Setter Property="Padding" Value="7 3 7 3" />
        <Setter Property="Background" Value="#1500F2FE" />
        <Setter Property="BorderBrush" Value="#3000F2FE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style
        x:Key="ItemHotkeyBGSelectedStyle"
        BasedOn="{StaticResource BaseItemHotkeyBGSelectedStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="6 0 10 0" />
        <Setter Property="Padding" Value="7 3 7 3" />
        <Setter Property="Background" Value="#3500F2FE" />
        <Setter Property="BorderBrush" Value="#7000F2FE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>



    <!-- Clock Styles -->
    <Style
        x:Key="ClockPanel"
        BasedOn="{StaticResource BaseClockPanel}"
        TargetType="{x:Type StackPanel}">
        <Setter Property="Margin" Value="0 0 72 0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="ClockBox"
        BasedOn="{StaticResource BaseClockBox}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E0F8FF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="DateBox"
        BasedOn="{StaticResource BaseDateBox}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#80B0D8" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <!-- Glyph Styling -->
    <Style
        x:Key="ItemGlyph"
        BasedOn="{StaticResource BaseGlyphStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#00F2FE" />
    </Style>

    <!-- ScrollBar Styles -->
    <Style
        x:Key="ThumbStyle"
        BasedOn="{StaticResource BaseThumbStyle}"
        TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        Background="#5000F2FE"
                        BorderBrush="Transparent"
                        CornerRadius="2"
                        DockPanel.Dock="Right" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ScrollBarStyle"
        BasedOn="{StaticResource BaseScrollBarStyle}"
        TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="4" />
    </Style>

</ResourceDictionary>
