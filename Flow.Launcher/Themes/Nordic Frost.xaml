<!--
    Name: Nordic Frost
    IsDark: True
    HasBlur: True
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Theme & Icon Pack Settings -->
    <system:Boolean x:Key="ThemeBlurEnabled">True</system:Boolean>
    <system:String x:Key="ThemeIconPack">Default</system:String>
    <system:String x:Key="SystemBG">Dark</system:String>
    <Color x:Key="LightBG">#C5141E2E</Color>
    <Color x:Key="DarkBG">#B00C1320</Color>

    <!-- Layout Metrics -->
    <Thickness x:Key="ResultMargin">0 6 0 8</Thickness>
    <Thickness x:Key="ItemMargin">8 3 8 3</Thickness>
    <CornerRadius x:Key="ItemRadius">12</CornerRadius>
    <system:Double x:Key="ResultItemHeight">54</system:Double>

    <!-- Arctic Frost Crystalline Gradients -->
    <LinearGradientBrush x:Key="NordicFrostBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#85A8C4E8" />
        <GradientStop Offset="0.4" Color="#A5C8E8FF" />
        <GradientStop Offset="0.75" Color="#7590B8E0" />
        <GradientStop Offset="1.0" Color="#85A8C4E8" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NordicCapsuleBorderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#60A8C4E8" />
        <GradientStop Offset="0.5" Color="#80C8E8FF" />
        <GradientStop Offset="1.0" Color="#6090B8E0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NordicQueryBoxBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#2880A8D0" />
        <GradientStop Offset="0.4" Color="#160C1322" />
        <GradientStop Offset="1.0" Color="#22121A2C" />
    </LinearGradientBrush>



    <!-- Result Item Interactive Colors (Frosted Glacier Pill) -->
    <LinearGradientBrush x:Key="ItemSelectedBorderColor" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#75A8C4E8" />
        <GradientStop Offset="0.5" Color="#90C8E8FF" />
        <GradientStop Offset="1.0" Color="#7590B8E0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ItemSelectedBackgroundColor" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#305078A8" />
        <GradientStop Offset="0.5" Color="#24406890" />
        <GradientStop Offset="1.0" Color="#2C5078A8" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ItemHoverBackgroundColor">#1680A8D0</SolidColorBrush>
    <SolidColorBrush x:Key="ItemHoverBorderColor">#30A8C4E8</SolidColorBrush>

    <!-- Window Styles -->
    <Style x:Key="WindowRadius" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style
        x:Key="WindowBorderStyle"
        BasedOn="{StaticResource BaseWindowBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="BorderThickness" Value="1.4" />
        <Setter Property="BorderBrush" Value="{StaticResource NordicFrostBorderBrush}" />
        <Setter Property="Background" Value="#A80C1320" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style
        x:Key="WindowStyle"
        BasedOn="{StaticResource BaseWindowStyle}"
        TargetType="{x:Type Window}" />

    <!-- Query Box Styles (Frosted Ice Pill) -->
    <Style
        x:Key="QueryBoxBgStyle"
        BasedOn="{StaticResource BaseQueryBoxBgStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="10 8 10 4" />
        <Setter Property="Background" Value="{StaticResource NordicQueryBoxBgBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="BorderBrush" Value="{StaticResource NordicCapsuleBorderBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style
        x:Key="QueryBoxStyle"
        BasedOn="{StaticResource BaseQueryBoxStyle}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="0 0 52 0" />
        <Setter Property="Foreground" Value="#F8FCFF" />
        <Setter Property="CaretBrush" Value="#C8E0FF" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style
        x:Key="QuerySuggestionBoxStyle"
        BasedOn="{StaticResource BaseQuerySuggestionBoxStyle}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="0 0 52 0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="42" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="#6590B8E0" />
    </Style>

    <!-- Separators & Pending Line -->
    <Style
        x:Key="SeparatorStyle"
        BasedOn="{StaticResource BaseSeparatorStyle}"
        TargetType="{x:Type Rectangle}">
        <Setter Property="Fill">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#00A8C4E8" />
                    <GradientStop Offset="0.3" Color="#40A8C4E8" />
                    <GradientStop Offset="0.5" Color="#70C8E8FF" />
                    <GradientStop Offset="0.7" Color="#4090B8E0" />
                    <GradientStop Offset="1.0" Color="#0090B8E0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Height" Value="1.0" />
        <Setter Property="Margin" Value="12 4 12 6" />
    </Style>

    <Style
        x:Key="PendingLineStyle"
        BasedOn="{StaticResource BasePendingLineStyle}"
        TargetType="{x:Type Line}">
        <Setter Property="Stroke">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#85A8C4E8" />
                    <GradientStop Offset="0.5" Color="#C8E8FF" />
                    <GradientStop Offset="1.0" Color="#7590B8E0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Result Item Typography (Crisp Nordic White & Muted Slate) -->
    <Style
        x:Key="ItemTitleStyle"
        BasedOn="{StaticResource BaseItemTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F0F6FC" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="ItemSubTitleStyle"
        BasedOn="{StaticResource BaseItemSubTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#8FA8C4" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style
        x:Key="ItemTitleSelectedStyle"
        BasedOn="{StaticResource BaseItemTitleSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style
        x:Key="ItemSubTitleSelectedStyle"
        BasedOn="{StaticResource BaseItemSubTitleSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#D0E8FF" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="HighlightStyle">
        <Setter Property="Inline.FontWeight" Value="Bold" />
        <Setter Property="Inline.Foreground" Value="#70C8FF" />
    </Style>

    <!-- Selection Capsule Indicator -->
    <Style
        x:Key="BulletStyle"
        BasedOn="{StaticResource BaseBulletStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style
        x:Key="ItemBulletSelectedStyle"
        BasedOn="{StaticResource BaseBulletStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="4 0 0 0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#A8C4E8" />
                    <GradientStop Offset="1.0" Color="#6088B8" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hotkey Badges -->
    <Style
        x:Key="ItemHotkeyStyle"
        BasedOn="{StaticResource BaseItemHotkeyStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#8FA8C4" />
    </Style>

    <Style
        x:Key="ItemHotkeySelectedStyle"
        BasedOn="{StaticResource BaseItemHotkeySelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style
        x:Key="ItemHotkeyBGStyle"
        BasedOn="{StaticResource BaseItemHotkeyBGStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="6 0 10 0" />
        <Setter Property="Padding" Value="6 2 6 2" />
        <Setter Property="Background" Value="#15A8C4E8" />
        <Setter Property="BorderBrush" Value="#25A8C4E8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style
        x:Key="ItemHotkeyBGSelectedStyle"
        BasedOn="{StaticResource BaseItemHotkeyBGSelectedStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="6 0 10 0" />
        <Setter Property="Padding" Value="6 2 6 2" />
        <Setter Property="Background" Value="#30A8C4E8" />
        <Setter Property="BorderBrush" Value="#60A8C4E8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>



    <!-- Clock Styles -->
    <Style
        x:Key="ClockPanel"
        BasedOn="{StaticResource BaseClockPanel}"
        TargetType="{x:Type StackPanel}">
        <Setter Property="Margin" Value="0 0 72 0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="ClockBox"
        BasedOn="{StaticResource BaseClockBox}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E0EDF8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="DateBox"
        BasedOn="{StaticResource BaseDateBox}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#8FA8C4" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <!-- Glyph Styling -->
    <Style
        x:Key="ItemGlyph"
        BasedOn="{StaticResource BaseGlyphStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#85A8C4E8" />
    </Style>

    <!-- ScrollBar Styles -->
    <Style
        x:Key="ThumbStyle"
        BasedOn="{StaticResource BaseThumbStyle}"
        TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        Background="#50A8C4E8"
                        BorderBrush="Transparent"
                        CornerRadius="2"
                        DockPanel.Dock="Right" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ScrollBarStyle"
        BasedOn="{StaticResource BaseScrollBarStyle}"
        TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="4" />
    </Style>

</ResourceDictionary>
